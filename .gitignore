# Independent nested repository
remotion/

# Python and local runtime artifacts
__pycache__/
*.py[cod]

# CRM runtime logs (keep the structured A2A handoff log)
ai-assistant/crm-dashboard/logs/crm-dashboard.jsonl
ai-assistant/crm-dashboard/logs/launcher.jsonl
ai-assistant/crm-dashboard/logs/*.stdout.log
ai-assistant/crm-dashboard/logs/*.stderr.log

# Local-only CRM and outreach data. These paths may contain customer records,
# contact details, notes, exports, backups, or raw lead material and must never
# be included in the shared CMR repository.
/ai-assistant/clients/
/ai-assistant/leads/
/ai-assistant/output/
/ai-assistant/raw/
/outputs/
/ai-assistant/crm-dashboard/data/
/ai-assistant/crm-dashboard/exports/
/ai-assistant/crm-dashboard/backups/

# Product knowledge base and pricing material (business data, never public)
/llm-wiki-mvp/

# Local agent runtime state and credentials
/.workbuddy/
/opencode.jsonc

# Local secrets; examples contain variable names only.
.env
.env.*
!.env.example

# Local scratch material and one-off helper scripts
/generated-images/
/新建文件夹/
/read_excel.ps1

# AWR local runtime state
/.awr/
.awr/state.db
.awr/state.db-*
.awr/artifacts/
.awr/mutations/
.awr/cache/
.awr/clients/
.awr/executions/

# Windows DPAPI encrypted local credentials (never commit)
/.secrets/
